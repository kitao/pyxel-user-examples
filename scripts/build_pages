#!/usr/bin/env python3
"""Build the gallery site into dist/."""

import argparse
import shutil

import jinja2
import yaml
from catalog import ROOT_DIR, load_entries, read_preview_size

ITEMS_PER_PAGE = 18
# The Worker serves dist/ from the domain root, and the gallery under this path.
SITE_DIR = "pyxel/user-examples"
ASSETS = ("styles.css", "lightbox.js")


def render_pages(entries, root):
    """Return the HTML of each page by its path in the site."""
    entries = [
        dict(entry, size=read_preview_size(entry["id"], root)) for entry in entries
    ]
    chunks = [
        entries[i : i + ITEMS_PER_PAGE] for i in range(0, len(entries), ITEMS_PER_PAGE)
    ]
    # Numbered pages keep their URLs as entries are added, and directory URLs are
    # served without a redirect.
    pages = [
        {
            "label": f"{chunk[0]['id']}-{chunk[-1]['id']}",
            "dir": "" if number == 1 else f"page/{number}/",
            "entries": chunk,
        }
        for number, chunk in enumerate(chunks, start=1)
    ]
    template = jinja2.Environment(
        loader=jinja2.FileSystemLoader(root / "templates"),
        autoescape=True,
        undefined=jinja2.StrictUndefined,
        trim_blocks=True,
        lstrip_blocks=True,
        keep_trailing_newline=True,
    ).get_template("page.html")
    return {
        page["dir"] + "index.html": template.render(
            pages=pages, index=index, root="../" * page["dir"].count("/")
        )
        for index, page in enumerate(pages)
    }


def source_path(root, name):
    path = root / name
    # A symlink could publish a file from outside the repository.
    if path.resolve(strict=True) != path:
        raise ValueError(f"Sources must not be symlinks: {name}")
    return path


def build(target, root):
    """Validate the sources, then replace the contents of target with the site."""
    root = root.resolve()
    # The catalog and the template end up in the pages.
    for name in ("examples.yml", "templates/page.html"):
        source_path(root, name)
    entries = load_entries(root)
    pages = render_pages(entries, root)
    sources = {"_headers": source_path(root, "_headers")}
    for name in (*ASSETS, *(f"images/{entry['id']}.gif" for entry in entries)):
        sources[f"{SITE_DIR}/{name}"] = source_path(root, name)
    # Unlink a symlinked target instead of emptying the directory it points to.
    if target.is_symlink():
        target.unlink()
    # Keep the directory itself, which a running wrangler dev serves from.
    target.mkdir(parents=True, exist_ok=True)
    for path in target.iterdir():
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
        else:
            path.unlink()
    for name, html in pages.items():
        path = target / SITE_DIR / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(html, encoding="utf-8")
    for name, source in sources.items():
        path = target / name
        path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, path)


def main():
    parser = argparse.ArgumentParser(description="Build the gallery site into dist/.")
    parser.parse_args()
    try:
        build(ROOT_DIR / "dist", ROOT_DIR)
    except (OSError, ValueError, yaml.YAMLError, jinja2.TemplateError) as error:
        parser.exit(1, f"Error: {error}\n")
    print("Built the gallery in dist/")


if __name__ == "__main__":
    main()
