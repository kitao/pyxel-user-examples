#!/usr/bin/env python3
from pathlib import Path
import shutil

import yaml

ROOT_DIR = Path(__file__).resolve().parent.parent
ITEMS_PER_PAGE = 18
PAGES_DIR = ROOT_DIR / "pages"
SITE_TITLE = "Pyxel User Examples"


def load_entries():
    return yaml.safe_load((ROOT_DIR / "examples.yml").read_text(encoding="utf-8"))


def load_template():
    return (ROOT_DIR / "page.html").read_text(encoding="utf-8")


def escape_html(value):
    return (
        str(value)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def render_entry(entry, root):
    entry_id = entry["id"]
    title = escape_html(entry["title"])
    desc = escape_html(entry.get("desc", ""))
    author = escape_html(entry["author"])
    site = entry.get("site", "")
    contact = entry.get("contact", "")

    if site:
        title_html = (
            f'<a href="{escape_html(site)}" target="_blank" rel="noopener">'
            f"#{entry_id} {title}</a>"
        )
    else:
        title_html = f"#{entry_id} {title}"

    if contact:
        author_html = (
            f'<a href="{escape_html(contact)}" target="_blank" rel="noopener">'
            f"{author}</a>"
        )
    else:
        author_html = author

    img_src = f"{root}images/{entry_id}.gif"

    return f"""<div class="card">
  <img src="{img_src}" alt="{title}" loading="lazy">
  <div class="card-body">
    <h2>{title_html}</h2>
    <div class="meta">by {author_html}</div>
    <div class="desc">{desc}</div>
  </div>
</div>"""


def page_range_label(entries):
    return f"{entries[0]['id']}-{entries[-1]['id']}"


def page_href(pages, idx, root):
    if idx == 0:
        return f"{root}index.html"
    return f"{root}pages/{page_range_label(pages[idx])}.html"


def build_nav(pages, current_idx, root):
    parts = []

    if current_idx > 0:
        parts.append(f'<a href="{page_href(pages, current_idx - 1, root)}" class="nav-arrow">◀</a>')
    else:
        parts.append('<span class="nav-arrow disabled">◀</span>')

    for i, page_entries in enumerate(pages):
        label = page_range_label(page_entries)
        if i == current_idx:
            parts.append(f"<span>{label}</span>")
        else:
            parts.append(f'<a href="{page_href(pages, i, root)}">{label}</a>')

    if current_idx < len(pages) - 1:
        parts.append(f'<a href="{page_href(pages, current_idx + 1, root)}" class="nav-arrow">▶</a>')
    else:
        parts.append('<span class="nav-arrow disabled">▶</span>')

    return "\n    ".join(parts)


def generate():
    entries = load_entries()
    template = load_template()
    pages = [
        entries[i : i + ITEMS_PER_PAGE]
        for i in range(0, len(entries), ITEMS_PER_PAGE)
    ]

    if PAGES_DIR.exists():
        shutil.rmtree(PAGES_DIR)
    PAGES_DIR.mkdir()

    for i, page_entries in enumerate(pages):
        label = page_range_label(page_entries)

        if i == 0:
            filepath = ROOT_DIR / "index.html"
            root = ""
            css_path = "styles.css"
        else:
            filepath = PAGES_DIR / f"{label}.html"
            root = "../"
            css_path = "../styles.css"

        entries_html = "\n".join(render_entry(e, root) for e in page_entries)
        nav = build_nav(pages, i, root)

        html = template
        html = html.replace("{{title}}", SITE_TITLE)
        html = html.replace("{{css_path}}", css_path)
        html = html.replace("{{root}}", root)
        html = html.replace("{{nav}}", nav)
        html = html.replace("{{entries}}", entries_html)

        filepath.write_text(html, encoding="utf-8")
        print(f"  {filepath}")

    print(f"\nGenerated {len(pages)} pages from {len(entries)} entries")


if __name__ == "__main__":
    generate()
