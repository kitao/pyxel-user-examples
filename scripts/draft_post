#!/usr/bin/env python3
import argparse
import re

import yaml
from catalog import load_entries

TEMPLATE = """\
{title} by {author} is now on Pyxel User Examples!

Pyxelユーザー作品集を更新しました。
コード非公開や日本語でも大丈夫です。お気軽にご投稿ください！

Examples 作品集:
https://kitao.github.io/pyxel-user-examples/

Submit 投稿する:
https://github.com/kitao/pyxel/discussions/new?category=user-examples

#pyxel #python #gamedev"""


def extract_x_username(contact):
    match = re.fullmatch(
        r"https?://(?:www\.)?(?:x|twitter)\.com/([A-Za-z0-9_]{1,15})/?(?:[?#].*)?",
        contact,
        re.IGNORECASE,
    )
    if match and match.group(1).lower() not in {
        "home",
        "intent",
        "share",
        "search",
        "i",
        "explore",
    }:
        return f"@{match.group(1)}"
    return None


def main():
    parser = argparse.ArgumentParser(description="Draft an X post for an example.")
    parser.add_argument("id", type=int, help="example ID")
    args = parser.parse_args()
    try:
        entries = load_entries()
    except (OSError, ValueError, yaml.YAMLError) as error:
        parser.exit(1, f"Error: {error}\n")

    for entry in entries:
        if entry["id"] == args.id:
            break
    else:
        parser.exit(1, f"Entry #{args.id} not found\n")

    username = extract_x_username(entry.get("contact", ""))
    author = username if username else entry["author"]

    print(TEMPLATE.format(title=entry["title"], author=author))


if __name__ == "__main__":
    main()
