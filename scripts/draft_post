#!/usr/bin/env python3
from pathlib import Path
import re
import sys

import yaml

ROOT_DIR = Path(__file__).resolve().parent.parent

TEMPLATE = """\
{title} by {author} is now on Pyxel User Examples!

Pyxelユーザー作品集を更新しました。
コード非公開や日本語でも大丈夫です。お気軽にご投稿ください！

Examples 作品集:
https://kitao.github.io/pyxel-user-examples/

Submit 投稿する:
https://github.com/kitao/pyxel/discussions/new?category=user-examples

#pyxel #python #gamedev"""


def load_entries():
    return yaml.safe_load((ROOT_DIR / "examples.yml").read_text(encoding="utf-8"))


def extract_x_username(contact):
    m = re.match(r"https?://(?:www\.)?(?:x|twitter)\.com/([^/?#]+)", contact)
    return f"@{m.group(1)}" if m else None


def main():
    if len(sys.argv) != 2 or not sys.argv[1].isdigit():
        print(f"Usage: {sys.argv[0]} <id>", file=sys.stderr)
        sys.exit(1)

    target_id = int(sys.argv[1])
    entries = load_entries()

    for entry in entries:
        if entry["id"] == target_id:
            break
    else:
        print(f"Entry #{target_id} not found", file=sys.stderr)
        sys.exit(1)

    username = extract_x_username(entry.get("contact", ""))
    author = username if username else entry["author"]

    print(TEMPLATE.format(title=entry["title"], author=author))


if __name__ == "__main__":
    main()
